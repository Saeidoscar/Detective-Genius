    <!-- Onboarding -->
    <string name="onboarding_title_1">خوش آمدید کارآگاه</string>
    <string name="onboarding_desc_1">وارد دنیای استنتاج اجتماعی، رازها و معماهای هوشمندانه شوید که در آن همه درباره همه تحقیق می‌کنند.</string>
    <string name="onboarding_title_2">بنویسید و پاسخ دهید</string>
    <string name="onboarding_desc_2">سه سوال رازآلود طرح کنید. یکی از کارآگاهان به طور ناشناس به آنها پاسخ می‌دهد و شما نیز به سوالات شرکت‌کننده دیگری پاسخ می‌دهید.</string>
    <string name="onboarding_title_3">کشف ۴ راز بزرگ</string>
    <string name="onboarding_desc_3">یک بسته مهروموم‌شده مدارک دریافت کنید. حدس بزنید چه کسی به سوالات شما پاسخ داده، شما به سوالات چه کسی پاسخ داده‌اید، و پرونده در دست شما متعلق به چه کسی است.</string>
    <string name="onboarding_button_start">ورود به اداره کارآگاهی</string>
    <string name="onboarding_button_skip">رد کردن آموزش</string>

